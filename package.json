{
  "name": "@codebundlesbyvik/html-dev-label",
  "version": "3.2.1",
  "description": "An HTML element rendered on page which indicates your project is compiled with `process.env.NODE_ENV` set to `development`.",
  "keywords": [
    "NODE_ENV",
    "dev",
    "development",
    "environment",
    "target",
    "label",
    "indicator",
    "html",
    "module",
    "esm"
  ],
  "license": "MIT",
  "author": "codebundlesbyvik",
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikputthiscodeongit/html-dev-label.git"
  },
  "bugs": "https://github.com/vikputthiscodeongit/html-dev-label/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "lint-fix": "eslint --fix",
    "compile": "tsc",
    "minify": "terser dist/index.js --output dist/index.js --compress ecma=2022,module=true,passes=2",
    "build": "npm run lint-fix && rimraf dist && cross-env NODE_ENV=production npm run compile && npm run minify"
  },
  "dependencies": {
    "@codebundlesbyvik/js-helpers": "^2.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tsconfig/recommended": "^1.0.10",
    "@types/node": "^24.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=12.22.0"
  }
}
