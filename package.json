{
  "name": "@codebundlesbyvik/html-dev-label",
  "version": "3.2.1",
  "description": "An HTML element rendered on page which indicates your project is compiled with `process.env.NODE_ENV` set to `development`.",
  "keywords": [
    "NODE_ENV",
    "dev",
    "development",
    "environment",
    "target",
    "label",
    "indicator",
    "html",
    "module",
    "esm"
  ],
  "license": "MIT",
  "author": "codebundlesbyvik",
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikputthiscodeongit/html-dev-label.git"
  },
  "bugs": "https://github.com/vikputthiscodeongit/html-dev-label/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "lint-fix": "eslint --fix",
    "compile": "tsc",
    "minify": "terser dist/index.js --output dist/index.js --compress ecma=2022,module=true,passes=2",
    "build": "npm run lint-fix && rimraf dist && cross-env NODE_ENV=production npm run compile && npm run minify"
  },
  "dependencies": {
    "@codebundlesbyvik/js-helpers": "^2.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tsconfig/recommended": "^1.0.8",
    "@types/node": "^22.15.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "terser": "^5.39.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "engines": {
    "node": ">=12.22.0"
  }
}
